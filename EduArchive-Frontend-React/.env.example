# Public build configuration only. Replace with the approved HTTPS API URL
# ending in /api/v1, or /api/v1 for a deliberately configured same-origin host.
# Omit for local development; production builds require an explicit setting.
VITE_API_BASE_URL=
# Public Google OAuth web client ID. Must match backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

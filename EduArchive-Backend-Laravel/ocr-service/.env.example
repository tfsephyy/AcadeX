# EduArchive OCR Service — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Server
OCR_HOST=0.0.0.0
OCR_PORT=8001

# Set to 1 to enable GPU acceleration (requires CUDA + PaddlePaddle GPU build)
# GPU dramatically speeds up both detection and recognition for large batches.
USE_GPU=0

# PaddleOCR model directory (leave blank to use bundled defaults)
# Override to point at cached weights and avoid re-downloading on each env reset.
# DET_MODEL_DIR=
# REC_MODEL_DIR=
# CLS_MODEL_DIR=

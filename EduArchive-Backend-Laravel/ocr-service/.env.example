# Process environment template only; Python does not load this file automatically.
# Uvicorn host/port/workers are explicit launch arguments, CPU OCR is fixed in code.
OCR_MODEL_CACHE=<private-persistent-model-cache-directory>
TMPDIR=<private-temporary-directory-on-linux>
HOME=<private-service-home>
OMP_NUM_THREADS=<bounded-cpu-thread-count>
MKL_NUM_THREADS=<bounded-cpu-thread-count>

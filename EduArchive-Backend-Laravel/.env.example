# Names and placeholders only. Configure privately for local development or deployment.
# Existing private .env was not changed. Never paste secrets into chat.
# Preserve the original APP_KEY when restoring encrypted documents.
APP_NAME=<application-name>
APP_ENV=<local-testing-staging-or-production>
APP_KEY=<private-existing-or-new-empty-archive-key>
APP_PREVIOUS_KEYS=<private-previous-keys-if-applicable>
APP_DEBUG=<boolean-disabled-outside-local-development>
APP_URL=<local-api-origin-or-approved-https-api-origin>
FRONTEND_URL=<local-frontend-origin-or-approved-https-frontend-origin>
TRUSTED_PROXIES=<explicit-proxy-ip-or-cidr-list-or-empty>
DB_CONNECTION=<mysql-engine>
DB_HOST=<private-database-host>
DB_PORT=<database-port>
DB_DATABASE=<isolated-database-name>
DB_USERNAME=<scoped-database-account>
DB_PASSWORD=<private-database-password>
SESSION_DRIVER=<persistent-session-driver>
SESSION_LIFETIME=<minutes>
SESSION_COOKIE=<unique-cookie-name>
SESSION_DOMAIN=<empty-for-host-only>
SESSION_SECURE_COOKIE=<enabled-boolean>
SESSION_SAME_SITE=<same-site-policy>
CACHE_STORE=<isolated-cache-store>
CACHE_PREFIX=<unique-application-prefix>
UPLOAD_LOCK_STORE=<isolated-inter-process-cache-store>
QUEUE_CONNECTION=<approved-queue-connection>
DB_QUEUE_RETRY_AFTER=<seconds-greater-than-job-timeout>
# For Redis queue mode, set only after the private Redis service is healthy.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=<private-redis-password>
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=660
GOOGLE_CLIENT_ID=
OCR_SERVICE_URL=<private-loopback-ocr-origin>
PRIVATE_TEMP_PATH=<private-writable-temp-directory>
ALLOW_LEGACY_PLAINTEXT_DOCUMENTS=<disabled-boolean>
MAIL_MAILER=<approved-mail-transport>
MAIL_HOST=<mail-provider-host>
MAIL_PORT=<mail-provider-port>
MAIL_SCHEME=<mail-provider-tls-scheme>
MAIL_USERNAME=<private-mail-account>
MAIL_PASSWORD=<private-mail-password>
MAIL_FROM_ADDRESS=<verified-sender-address>
MAIL_FROM_NAME=<approved-sender-name>
LOG_CHANNEL=<rotating-log-channel>
LOG_LEVEL=<approved-log-level>
LOG_DAILY_DAYS=<retention-days>
# Application ceiling in bytes; 0 selects the 128 MiB bounded-stream limit.
# PHP-FPM examples use 128M file / 140M request / 512M memory.
# A positive application limit may only lower the maximum.
ACADEX_MAX_UPLOAD_BYTES=0
# Automatic extraction is optional and independent of accepted file size.
MAX_AUTOMATIC_EXTRACTION_BYTES=20971520
# Per-owner staged-upload quotas (count and encrypted bytes) and disk reserve.
MAX_PENDING_UPLOADS=20
MAX_PENDING_UPLOAD_BYTES=268435456
MIN_FREE_STORAGE_BYTES=2147483648

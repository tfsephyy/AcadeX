# Private disposable MySQL test environment. Never copy archive credentials here.
# Explicit administrator approval and a dedicated scoped account are required.
# No test database is deleted by the runner.
APP_ENV=<testing-environment>
APP_KEY=<new-private-test-key>
APP_DEBUG=<boolean>
APP_URL=<local-test-api-origin>
DB_CONNECTION=<mysql-engine>
DB_HOST=<approved-local-mysql-host>
DB_PORT=<mysql-port>
DB_DATABASE=<acadex_remediation_test_followed-by-ten-lowercase-hex-characters>
DB_USERNAME=<dedicated-disposable-db-account>
DB_PASSWORD=<private-test-password>
SESSION_DRIVER=<array-for-unit-tests>
CACHE_STORE=<array-for-unit-tests>
QUEUE_CONNECTION=<sync-for-unit-tests>
MAIL_MAILER=<array-no-external-mail>
LOG_CHANNEL=<stderr-for-tests>
BCRYPT_ROUNDS=<test-work-factor>
PRIVATE_STORAGE_ROOT=<isolated-local-test-storage>
APP_CONFIG_CACHE=<isolated-nonexistent-config-cache-path>
APP_ROUTES_CACHE=<isolated-nonexistent-route-cache-path>
APP_PACKAGES_CACHE=<isolated-package-cache-path>
APP_SERVICES_CACHE=<isolated-service-cache-path>
VIEW_COMPILED_PATH=<isolated-view-cache-directory>

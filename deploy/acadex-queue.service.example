# TEMPLATE ONLY. Replace every <placeholder>; no shared service/global changes.
[Unit]
Description=AcadeX PDF text maintenance queue
After=network.target

[Service]
Type=simple
User=<application-worker-user>
Group=<application-worker-group>
WorkingDirectory=<approved-backend-release-directory>
ExecStart=<verified-php-cli-path> artisan queue:work --sleep=3 --tries=2 --timeout=600
Restart=on-failure
RestartSec=5
TimeoutStopSec=660
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# TEMPLATE ONLY. Replace every <placeholder>; review for the actual Ubuntu host.
[Unit]
Description=AcadeX private OCR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<ocr-service-user>
Group=<ocr-service-group>
WorkingDirectory=<approved-ocr-release-directory>
Environment=HOME=<private-service-home>
Environment=OCR_MODEL_CACHE=<persistent-private-model-cache>
Environment=TMPDIR=<private-temp-directory>
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=<linux-venv-directory>/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1 --limit-concurrency 4 --backlog 32 --timeout-graceful-shutdown 180
Restart=on-failure
RestartSec=5
TimeoutStopSec=200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=<private-service-home> <persistent-private-model-cache> <private-temp-directory>

[Install]
WantedBy=multi-user.target
